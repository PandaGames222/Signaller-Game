{
  "name": "signaller-game",
  "version": "1.0.0",
  "productName": "Signaller",
  "author": "PandaGames222",
  "description": "A standalone 2D railway signalling and network-building game.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis --publish never",
    "publish:win": "electron-builder --win nsis --publish always"
  },
  "build": {
    "appId": "com.pandagames.signallergame",
    "productName": "Signaller",
    "asar": true,
    "files": [
      "index.html",
      "styles.css",
      "renderer.js",
      "main.js",
      "preload.js",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Signaller",
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "PandaGames222",
        "repo": "Signaller-Game",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0"
  },
  "overrides": {
    "minimatch": "^11.0.5"
  }
}
