<Window x:Class="Signaller.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Signaller"
        xmlns:logic="clr-namespace:Signaller.GameLogic;assembly=Signaller.GameLogic"
        Title="Signaller — Railway Control"
        Icon="Assets/Signaller.ico"
        Width="1440"
        Height="900"
        MinWidth="1024"
        MinHeight="680"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="MainWindow_PreviewKeyDown"
        Background="#0D1218"
        Foreground="#E7EDF3"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Grid Margin="36,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="78" />
            <RowDefinition Height="120" />
            <RowDefinition Height="*" />
            <RowDefinition Height="39" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="38" Height="38" CornerRadius="11"
                        Background="{StaticResource CardBackground}"
                        BorderBrush="#36554A" BorderThickness="1">
                    <Image Source="Assets/Signaller.ico" Width="31" Height="31" />
                </Border>
                <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="SIGNALLER" FontSize="13" FontWeight="Bold" />
                    <TextBlock Text="RAILWAY CONTROL" Margin="0,3,0,0" FontSize="9"
                               Foreground="#82909D" />
                </StackPanel>
            </StackPanel>

            <Border x:Name="ModeNavigation" Grid.Column="1" Padding="4" Background="#111820"
                    BorderBrush="#293541" BorderThickness="1" CornerRadius="9">
                <Grid>
                    <StackPanel x:Name="OriginalModeNavigation" Orientation="Horizontal">
                        <RadioButton x:Name="SignallerModeButton"
                                     GroupName="GameMode"
                                     Content="◉   Signaller Mode"
                                     IsChecked="True"
                                     Checked="SignallerModeButton_Checked" />
                        <RadioButton x:Name="EditorModeButton"
                                     GroupName="GameMode"
                                     Content="⌘   Editor Mode"
                                     Checked="EditorModeButton_Checked" />
                        <Button Content="⌂  MAIN MENU" Padding="9,7" FontSize="9"
                                Click="MenuButton_Click" />
                    </StackPanel>
                    <StackPanel x:Name="RegularModeNavigation" Orientation="Horizontal"
                                VerticalAlignment="Center" Visibility="Collapsed">
                        <TextBlock Text="REGULAR SIGNALLER DESK" Foreground="#73E0B0"
                                   FontSize="9" VerticalAlignment="Center" Margin="9,0,12,0" />
                        <Button Content="⌂  MAIN MENU" Padding="9,7" FontSize="9"
                                Click="MenuButton_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Orientation="Horizontal">
                <Ellipse Width="7" Height="7" Margin="0,0,8,0" Fill="#73E0B0">
                    <Ellipse.Effect>
                        <DropShadowEffect BlurRadius="8" ShadowDepth="0" Opacity="0.8" Color="#73E0B0" />
                    </Ellipse.Effect>
                </Ellipse>
                <TextBlock x:Name="VersionText" Text="VERSION 1.4.0" Foreground="#82909D"
                           FontSize="9" VerticalAlignment="Center" />
                <Button x:Name="UpdateButton" Content="UPDATE" Margin="10,0,0,0"
                        Padding="9,7" FontSize="9" Click="UpdateButton_Click"
                        ToolTip="Check for or install a Signaller update" />
            </StackPanel>
        </Grid>
        <Border Grid.Row="0" VerticalAlignment="Bottom" BorderBrush="#26313C"
                BorderThickness="0,0,0,1" />

        <Grid Grid.Row="1" Margin="0,9,0,13">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="190" />
                <ColumnDefinition Width="190" />
                <ColumnDefinition Width="190" />
                <ColumnDefinition Width="108" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock x:Name="ModeEyebrow" Text="NETWORK OPERATIONS" Foreground="#82909D"
                           FontSize="9" />
                <TextBlock x:Name="ModeTitle" Text="Signaller desk" Margin="0,5,0,0"
                           FontSize="21" FontWeight="SemiBold" />
            </StackPanel>
            <Border Grid.Column="1" Margin="5,0" Padding="12,9" CornerRadius="10"
                    Background="{StaticResource CardBackground}" BorderBrush="{StaticResource Border}" BorderThickness="1">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="32" Height="32" CornerRadius="8" Background="#202E2A">
                        <TextBlock Text="$" Foreground="#73E0B0" FontSize="17" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="AVAILABLE BALANCE" Foreground="#91A2AA" FontSize="8" />
                        <TextBlock x:Name="BalanceText" Text="$5,000" Margin="0,3,0,0"
                                   FontSize="15" FontWeight="SemiBold" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Margin="5,0" Padding="12,9" CornerRadius="10"
                    Background="{StaticResource CardBackground}" BorderBrush="{StaticResource Border}" BorderThickness="1">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="32" Height="32" CornerRadius="8" Background="#202B35">
                        <TextBlock Text="↗" Foreground="#82B8E4" FontSize="17"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="NETWORK INCOME" Foreground="#91A2AA" FontSize="8" />
                        <TextBlock x:Name="IncomeText" Text="$0 / min" Margin="0,3,0,0"
                                   FontSize="15" FontWeight="SemiBold" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Grid.Column="3" Margin="5,0" Padding="12,9" CornerRadius="10"
                    Background="{StaticResource CardBackground}" BorderBrush="{StaticResource Border}" BorderThickness="1">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="32" Height="32" CornerRadius="8" Background="#2A261F">
                        <TextBlock Text="▰" Foreground="#F5BB61" FontSize="16"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="ACTIVE TRAINS" Foreground="#91A2AA" FontSize="8" />
                        <TextBlock x:Name="TrainStatusText" Text="01  IN SERVICE" Margin="0,3,0,0"
                                   FontSize="13" FontWeight="SemiBold" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <StackPanel Grid.Column="4" VerticalAlignment="Center" HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Ellipse Width="5" Height="5" Margin="0,0,5,0" Fill="#73E0B0" />
                    <TextBlock Text="LIVE" Foreground="#73E0B0" FontSize="8" />
                </StackPanel>
                <TextBlock x:Name="ClockText" Text="08:00" Margin="0,3,0,0"
                           FontFamily="Consolas" FontSize="18" HorizontalAlignment="Right" />
                <TextBlock Text="NETWORK TIME" Foreground="#82909D" FontSize="8"
                           HorizontalAlignment="Right" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="2" CornerRadius="14" Background="#111A20" BorderBrush="#2C3B44"
                BorderThickness="1" ClipToBounds="True" Effect="{StaticResource CardShadow}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="EditorColumn" Width="0" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border x:Name="EditorPanel" Grid.Column="0" Padding="16" Background="#151D25"
                        BorderBrush="#26323D" BorderThickness="0,0,1,0" Visibility="Collapsed">
                    <DockPanel LastChildFill="True">
                        <StackPanel DockPanel.Dock="Top">
                            <TextBlock Text="NETWORK BUILDER" Foreground="#82909D" FontSize="9" />
                            <TextBlock Text="Build your railway" Margin="0,6,0,0" FontSize="17"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="Connect track tiles from a depot to a station to open an operating route."
                                       Margin="0,7,0,15" Foreground="#82909D" FontSize="11"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel DockPanel.Dock="Bottom">
                            <TextBlock Text="Tracks connect by matching edges. Depot-to-station routes enter the timetable automatically."
                                       Margin="2,12,2,12" Foreground="#96A4AE" FontSize="10"
                                       TextWrapping="Wrap" LineHeight="15" />
                            <Button x:Name="RotateButton" Content="↻   Rotate piece · R"
                                    Margin="0,0,0,7" Click="RotateButton_Click"
                                    ToolTip="Rotate the selected track piece by 90 degrees" />
                            <Button x:Name="DemolishButton" Content="⌫   Demolish · 50% refund"
                                    Click="DemolishButton_Click" />
                        </StackPanel>

                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="BuildList" />
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <Grid Grid.Column="1" ClipToBounds="True">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="49" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="34" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="17,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="6" Height="6" Fill="#73E0B0" />
                            <TextBlock Text="GREYFIELD CONTROL AREA" Margin="9,0,0,0" FontSize="10"
                                       FontWeight="SemiBold" />
                            <Border Height="13" Margin="10,0" BorderBrush="#34414D"
                                    BorderThickness="1,0,0,0" />
                            <TextBlock x:Name="MapSubtitle" Text="SIGNALLING DIAGRAM"
                                       Foreground="#82909D" FontSize="9" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Margin="0,0,14,0">
                                <Border Width="12" Height="2" Margin="0,0,5,0" Background="#788894" />
                                <TextBlock Text="Track" Foreground="#82909D" FontSize="9" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,14,0">
                                <Ellipse Width="7" Height="7" Margin="0,0,5,0" Fill="#F26B72" />
                                <TextBlock Text="Signal" Foreground="#82909D" FontSize="9" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,14,0">
                                <Border Width="12" Height="6" Margin="0,0,5,0" CornerRadius="2"
                                        Background="#F5BB61" />
                                <TextBlock Text="Train" Foreground="#82909D" FontSize="9" />
                            </StackPanel>
                            <Button x:Name="PauseButton" Content="Ⅱ" Width="29" Height="28"
                                    Padding="0" Click="PauseButton_Click"
                                    ToolTip="Pause the game simulation" />
                        </StackPanel>
                    </Grid>
                    <Border Grid.Row="0" VerticalAlignment="Bottom" BorderBrush="#242E38"
                            BorderThickness="0,0,0,1" />

                    <local:RailwaySurface x:Name="Railway"
                                          Grid.Row="1"
                                          ClipToBounds="True"
                                          MouseLeftButtonUp="Railway_MouseLeftButtonUp"
                                          MouseMove="Railway_MouseMove"
                                          MouseLeave="Railway_MouseLeave" />
                    <Border x:Name="RegularDeskPanel" Grid.Row="1" Margin="18"
                            Background="#0F171E" BorderBrush="#2C3B44" BorderThickness="1"
                            CornerRadius="10" Visibility="Collapsed">
                        <Grid Margin="18">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="TRAFFIC MANAGEMENT" Foreground="#82909D"
                                               FontSize="9" />
                                    <TextBlock Text="Control desk" Margin="0,5,0,0"
                                               FontSize="20" FontWeight="SemiBold" />
                                </StackPanel>
                                <Border Grid.Column="1" Padding="11,8" CornerRadius="7"
                                        Background="#17241F" BorderBrush="#36554A" BorderThickness="1"
                                        VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="6" Height="6" Fill="#73E0B0" />
                                        <TextBlock Text=" LIVE NETWORK" Margin="7,0,0,0"
                                                   Foreground="#A7D7BD" FontSize="8"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.15*" />
                                    <ColumnDefinition Width="0.85*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="1.1*" />
                                    <RowDefinition Height="0.9*" />
                                </Grid.RowDefinitions>
                                <Border Grid.ColumnSpan="2" Margin="0,0,0,10" Padding="13"
                                        CornerRadius="8" Background="#141E26"
                                        BorderBrush="#293944" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="ROUTE OVERVIEW" Foreground="#82909D"
                                                   FontSize="8" />
                                        <UniformGrid x:Name="RegularRoutesPanel" Columns="3"
                                                     Margin="0,11,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Row="1" Margin="0,0,10,0" Padding="13"
                                        CornerRadius="8" Background="#141E26"
                                        BorderBrush="#293944" BorderThickness="1">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Top" Text="ACTIVE SERVICES"
                                                   Foreground="#82909D" FontSize="8" Margin="0,0,0,9" />
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <StackPanel x:Name="RegularTrainList" />
                                        </ScrollViewer>
                                    </DockPanel>
                                </Border>
                                <Border Grid.Column="1" Grid.Row="1" Padding="13"
                                        CornerRadius="8" Background="#141E26"
                                        BorderBrush="#293944" BorderThickness="1">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Top" Text="SIGNAL BOARD"
                                                   Foreground="#82909D" FontSize="8" Margin="0,0,0,9" />
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <StackPanel x:Name="RegularSignalsPanel" />
                                        </ScrollViewer>
                                    </DockPanel>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>
                    <Border x:Name="ToastBorder" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Top"
                            Margin="0,14,0,0" Padding="12,7" CornerRadius="7"
                            Background="#162620" BorderBrush="#3B574C" BorderThickness="1"
                            IsHitTestVisible="False"
                            Visibility="Collapsed" Effect="{StaticResource CardShadow}">
                        <TextBlock x:Name="StatusToast" Text="" Foreground="#C3F1D9" FontSize="11" />
                    </Border>
                    <Border x:Name="TrainInfoPanel" Grid.Row="1" HorizontalAlignment="Right"
                            VerticalAlignment="Top" Margin="0,14,16,0" Padding="15"
                            Width="270" CornerRadius="10" Background="#121C24"
                            BorderBrush="#3A505B" BorderThickness="1" Visibility="Collapsed"
                            Effect="{StaticResource CardShadow}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="TRAIN DETAILS" Foreground="#82909D" FontSize="9" />
                                    <TextBlock x:Name="TrainInfoHeadcode" Text="2K14" Margin="0,5,0,0"
                                               FontSize="21" FontWeight="SemiBold" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="×" Width="28" Height="28" Padding="0"
                                        HorizontalAlignment="Right" VerticalAlignment="Top"
                                        Click="CloseDetailsButton_Click" />
                            </Grid>
                            <TextBlock x:Name="TrainInfoService" Text="Greyfield Local" Margin="0,3,0,12"
                                       Foreground="#73E0B0" FontSize="11" />
                            <TextBlock x:Name="TrainInfoType" Text="Class 170 Turbostar"
                                       Foreground="#E7EDF3" FontSize="11" />
                            <Border Margin="0,11,0,10" BorderBrush="#293944" BorderThickness="0,1,0,0" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="LATENCY" Foreground="#82909D" FontSize="8" />
                                    <TextBlock x:Name="TrainInfoLatency" Text="ON TIME" Margin="0,4,0,0"
                                               FontSize="11" FontWeight="SemiBold" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="LINE SPEED" Foreground="#82909D" FontSize="8" />
                                    <TextBlock x:Name="TrainInfoSpeed" Text="47 km/h" Margin="0,4,0,0"
                                               FontSize="11" FontWeight="SemiBold" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="NEXT STOP" Margin="0,12,0,3" Foreground="#82909D" FontSize="8" />
                            <TextBlock x:Name="TrainInfoNextStation" Text="Greyfield Central · Platform 1"
                                       FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="ROUTE / DESTINATION" Margin="0,11,0,3"
                                       Foreground="#82909D" FontSize="8" />
                            <TextBlock x:Name="TrainInfoDestination" Text="Greyfield Main · Portside"
                                       FontSize="10" TextWrapping="Wrap" />
                            <TextBlock Text="STATUS" Margin="0,11,0,3" Foreground="#82909D" FontSize="8" />
                            <TextBlock x:Name="TrainInfoStatus" Text="In service" FontSize="10"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <Border x:Name="SignalControlPanel" Grid.Row="1" HorizontalAlignment="Right"
                            VerticalAlignment="Top" Margin="0,14,16,0" Padding="15"
                            Width="270" CornerRadius="10" Background="#121C24"
                            BorderBrush="#3A505B" BorderThickness="1" Visibility="Collapsed"
                            Effect="{StaticResource CardShadow}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="SIGNAL CONTROL" Foreground="#82909D" FontSize="9" />
                                    <TextBlock x:Name="SignalInfoId" Text="S01" Margin="0,5,0,0"
                                               FontSize="21" FontWeight="SemiBold" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="×" Width="28" Height="28" Padding="0"
                                        HorizontalAlignment="Right" VerticalAlignment="Top"
                                        Click="CloseDetailsButton_Click" />
                            </Grid>
                            <TextBlock x:Name="SignalInfoAspect" Text="CURRENT ASPECT · GREEN"
                                       Margin="0,4,0,14" Foreground="#AAB8C0" FontSize="9" />
                            <TextBlock Text="SELECT AN ASPECT OR PRESS 1, 2, OR 3"
                                       Margin="0,0,0,9" Foreground="#82909D" FontSize="8" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Tag="Green" Click="SignalAspectButton_Click"
                                        Width="62" Height="62" Margin="4" Padding="0"
                                        ToolTip="Green — clear (1)">
                                    <Ellipse Width="22" Height="22" Fill="#73E0B0" />
                                </Button>
                                <Button Tag="Yellow" Click="SignalAspectButton_Click"
                                        Width="62" Height="62" Margin="4" Padding="0"
                                        ToolTip="Yellow — caution (2)">
                                    <Ellipse Width="22" Height="22" Fill="#F5BB61" />
                                </Button>
                                <Button Tag="Red" Click="SignalAspectButton_Click"
                                        Width="62" Height="62" Margin="4" Padding="0"
                                        ToolTip="Red — stop (3)">
                                    <Ellipse Width="22" Height="22" Fill="#F26B72" />
                                </Button>
                            </StackPanel>
                            <TextBlock Text="GREEN · 1      YELLOW · 2      RED · 3"
                                       Margin="0,7,0,0" HorizontalAlignment="Center"
                                       Foreground="#82909D" FontSize="8" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Left"
                            Margin="16,0,0,12" Padding="0" Background="#111920"
                            Opacity="0.88" IsHitTestVisible="False">
                        <TextBlock x:Name="CanvasHint"
                                   Text="SELECT A SIGNAL FOR CONTROLS  ·  1 GREEN  ·  2 YELLOW  ·  3 RED"
                                   Foreground="#82909D" FontSize="8" />
                    </Border>
                    <Border Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Right"
                            Margin="0,0,16,12" Padding="8,4" CornerRadius="5"
                            Background="#111920" Opacity="0.88" IsHitTestVisible="False">
                        <TextBlock x:Name="TrainAlertText" Visibility="Collapsed"
                                   Foreground="#FFB0B3" FontSize="9" FontWeight="SemiBold" />
                    </Border>
                    <Grid Grid.Row="2" Margin="16,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="5" Height="5" Fill="#73E0B0" />
                            <TextBlock Text=" SYSTEMS NOMINAL" Margin="6,0,0,0" Foreground="#9EB4A9"
                                       FontSize="8" />
                        </StackPanel>
                        <TextBlock x:Name="RouteCountText" Grid.Column="1"
                                   Text="GREYFIELD CONTROL AREA  ·  3 ROUTES"
                                   Foreground="#71808C" FontSize="8" VerticalAlignment="Center"
                                   />
                    </Grid>
                    <Border Grid.Row="2" VerticalAlignment="Top" BorderBrush="#242E38"
                            BorderThickness="0,1,0,0" />
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Row="3">
            <TextBlock Text="Signaller" Foreground="#71808C" FontSize="9"
                       VerticalAlignment="Center">
                <Run Text="v" />
                <Run x:Name="FooterVersion" Text="1.4.0" Foreground="#89959E" />
            </TextBlock>
            <TextBlock Text="SAFE WORKING. EVERY JOURNEY." Foreground="#71808C" FontSize="8"
                       HorizontalAlignment="Right" VerticalAlignment="Center" />
        </Grid>
        <Grid x:Name="MenuOverlay" Grid.Row="1" Grid.RowSpan="3">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#111B22" Offset="0" />
                    <GradientStop Color="#0D1218" Offset="0.62" />
                    <GradientStop Color="#14201F" Offset="1" />
                </LinearGradientBrush>
            </Grid.Background>
            <Grid x:Name="HomePanel" Visibility="Visible">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.1*" />
                    <ColumnDefinition Width="0.9*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="50,0,20,0">
                    <Border Width="60" Height="60" CornerRadius="16" HorizontalAlignment="Left"
                            Background="#192721" BorderBrush="#416151" BorderThickness="1">
                        <Image Source="Assets/Signaller.ico" Width="48" Height="48" />
                    </Border>
                    <TextBlock Text="SIGNALLER" Margin="0,21,0,0" FontSize="13"
                               FontWeight="SemiBold" Foreground="#73E0B0" />
                    <TextBlock Text="Your railway.&#10;Your decisions." Margin="0,9,0,0"
                               FontSize="38" FontWeight="SemiBold" LineHeight="46" />
                    <TextBlock Text="Take control of a growing rail network. Set signals, manage traffic, and build new services."
                               Margin="0,17,0,0" MaxWidth="430" TextWrapping="Wrap"
                               Foreground="#9BAAB1" FontSize="13" LineHeight="21" />
                    <StackPanel Orientation="Horizontal" Margin="0,28,0,0">
                        <Border Padding="10,7" CornerRadius="5" Background="#17231F"
                                BorderBrush="#314B40" BorderThickness="1">
                            <TextBlock x:Name="MenuModeSummary" Text="2 GAME MODES"
                                       Foreground="#A7D7BD" FontSize="8" />
                        </Border>
                        <Border Margin="8,0,0,0" Padding="10,7" CornerRadius="5"
                                Background="#171F26" BorderBrush="#303E48" BorderThickness="1">
                            <TextBlock Text="AUTOSAVING" Foreground="#9BAAB1" FontSize="8" />
                        </Border>
                    </StackPanel>
                </StackPanel>
                <Border Grid.Column="1" MaxWidth="390" Padding="27" CornerRadius="13"
                        Background="#121B22" BorderBrush="#2D3C45" BorderThickness="1"
                        VerticalAlignment="Center" HorizontalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="WELCOME, SIGNALLER" Foreground="#82909D" FontSize="9" />
                        <TextBlock Text="Ready for duty?" Margin="0,6,0,18"
                                   FontSize="22" FontWeight="SemiBold" />
                        <Button Content="▶    PLAY" Height="58" FontSize="13"
                                Background="#20372E" BorderBrush="#416552"
                                Click="PlayButton_Click" />
                        <Button Content="⚙    SETTINGS" Height="48" Margin="0,10,0,0"
                                Click="SettingsButton_Click" />
                        <TextBlock Text="Choose a way to run your control area."
                                   Margin="0,17,0,0" HorizontalAlignment="Center"
                                   Foreground="#82909D" FontSize="10" />
                    </StackPanel>
                </Border>
            </Grid>
            <Grid x:Name="ModeSelectionPanel" Visibility="Collapsed">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="880">
                    <TextBlock Text="SELECT YOUR EXPERIENCE" HorizontalAlignment="Center"
                               Foreground="#73E0B0" FontSize="10" />
                    <TextBlock Text="Choose a game mode" Margin="0,7,0,25"
                               HorizontalAlignment="Center" FontSize="27" FontWeight="SemiBold" />
                    <UniformGrid Columns="2">
                        <Button Tag="{x:Static logic:GameStyle.Original}"
                                Click="GameStyleButton_Click"
                                Width="350" Height="212" Margin="8" Padding="22"
                                HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                            <StackPanel>
                                <TextBlock Text="01  ·  ORIGINAL" Foreground="#73E0B0" FontSize="9" />
                                <TextBlock Text="Network builder" Margin="0,9,0,0"
                                           FontSize="21" FontWeight="SemiBold" />
                                <TextBlock Text="The full railway map with construction, automatic routes, signal control, and live traffic."
                                           Margin="0,9,0,0" TextWrapping="Wrap" Foreground="#9BAAB1"
                                           FontSize="11" LineHeight="17" />
                                <TextBlock Text="MAP VIEW  ·  BUILD  ·  EXPAND"
                                           Margin="0,17,0,0" Foreground="#82909D" FontSize="8" />
                            </StackPanel>
                        </Button>
                        <Button Tag="{x:Static logic:GameStyle.Regular}"
                                Click="GameStyleButton_Click"
                                Width="350" Height="212" Margin="8" Padding="22"
                                HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                            <StackPanel>
                                <TextBlock Text="02  ·  REGULAR" Foreground="#82B8E4" FontSize="9" />
                                <TextBlock Text="Control desk" Margin="0,9,0,0"
                                           FontSize="21" FontWeight="SemiBold" />
                                <TextBlock Text="A focused signaller's console for monitoring route availability, train services, and signal aspects."
                                           Margin="0,9,0,0" TextWrapping="Wrap" Foreground="#9BAAB1"
                                           FontSize="11" LineHeight="17" />
                                <TextBlock Text="LIVE BOARD  ·  TIMETABLE  ·  SIGNALS"
                                           Margin="0,17,0,0" Foreground="#82909D" FontSize="8" />
                            </StackPanel>
                        </Button>
                    </UniformGrid>
                    <Button Content="←   BACK" Width="120" Margin="0,18,0,0"
                            HorizontalAlignment="Center" Click="BackToHomeButton_Click" />
                </StackPanel>
            </Grid>
            <Grid x:Name="SettingsPanel" Visibility="Collapsed">
                <Border Width="460" Padding="28" CornerRadius="12"
                        Background="#121B22" BorderBrush="#2D3C45" BorderThickness="1"
                        VerticalAlignment="Center" HorizontalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="PREFERENCES" Foreground="#73E0B0" FontSize="9" />
                        <TextBlock Text="Settings" Margin="0,6,0,20"
                                   FontSize="26" FontWeight="SemiBold" />
                        <Border Padding="14" CornerRadius="8" Background="#172129"
                                BorderBrush="#2D3C45" BorderThickness="1">
                            <DockPanel>
                                <CheckBox x:Name="EntrySoundCheckBox" DockPanel.Dock="Right"
                                          VerticalAlignment="Center" IsChecked="True"
                                          Checked="EntrySoundCheckBox_Changed"
                                          Unchecked="EntrySoundCheckBox_Changed" />
                                <StackPanel>
                                    <TextBlock Text="Train entry chime" FontSize="12"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="Play a sound when a service enters the control area."
                                               Margin="0,4,0,0" Foreground="#82909D" FontSize="10"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <Button Content="←   BACK TO MENU" Height="42" Margin="0,18,0,0"
                                Click="BackToHomeButton_Click" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
